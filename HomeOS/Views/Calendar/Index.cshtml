@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    // FullCalendar does not ship a "bs" locale - "hr" is the closest supported
    // one (near-identical day/month names) rather than falling back to a
    // generic, unlabeled date format.
    var calendarLocale = currentCulture == "bs" ? "hr" : currentCulture;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">@Localizer["PageTitle"]</h2>
    <a asp-action="Create" class="btn btn-primary">➕ @Localizer["NewEventButton"]</a>
</div>

<div id="calendar"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.17/locales-all.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');
            var calendar = new FullCalendar.Calendar(calendarEl, {
                locale: '@calendarLocale',
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
                },
                buttonText: {
                    today: '@Localizer["TodayButton"]',
                    month: '@Localizer["MonthButton"]',
                    week: '@Localizer["WeekButton"]',
                    day: '@Localizer["DayButton"]',
                    list: '@Localizer["ListButton"]'
                },
                height: 'auto',
                events: function (info, successCallback, failureCallback) {
                    var url = '@Url.Action("Events")?start=' + encodeURIComponent(info.startStr) + '&end=' + encodeURIComponent(info.endStr);
                    fetch(url)
                        .then(function (r) { return r.json(); })
                        .then(successCallback)
                        .catch(failureCallback);
                },
                dateClick: function (info) {
                    window.location.href = '@Url.Action("Create")?date=' + info.dateStr;
                }
            });
            calendar.render();
        });
    </script>
}
