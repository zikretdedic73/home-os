@using HomeOS.Models.Finance
@using HomeOS.Models.Common
@model Bill
@inject Microsoft.Extensions.Localization.IStringLocalizer<HomeOS.Controllers.FinanceController> L
@{
    ViewData["Title"] = L["EditBillTitle"];
}

<h2>@L["EditBillTitle"]</h2>

<form asp-action="EditBill" asp-route-id="@Model.Id" method="post" class="row g-3 mt-2">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsPaid" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_BillFields" model="Model" />
    <div class="col-12">
        <button type="submit" class="btn btn-primary">@L["SaveButton"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@L["BackButton"]</a>
    </div>
</form>
