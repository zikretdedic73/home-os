@model HomeOS.Models.Home.DashboardViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<h2 class="mb-3">@Localizer["PageTitle"]</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]</div>
}

@if (!Model.Widgets.Any())
{
    <p class="text-muted">@Localizer["NoModulesMessage"]</p>
}
else
{
    <div class="row g-3">
        @foreach (var widget in Model.Widgets)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-header fw-semibold">@widget.Title</div>
                    <div class="card-body">
                        @if (!widget.Items.Any())
                        {
                            <p class="text-muted mb-0">@widget.EmptyText</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var item in widget.Items)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-start px-0 @(item.Highlight ? "bg-danger-subtle" : "")">
                                        @if (!string.IsNullOrEmpty(item.Url))
                                        {
                                            <a href="@item.Url" class="text-decoration-none">@item.Title</a>
                                        }
                                        else
                                        {
                                            <span>@item.Title</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.Badge))
                                        {
                                            <span class="badge bg-danger">@item.Badge</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
