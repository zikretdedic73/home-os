@model List<HomeOS.Models.Kanban.Board>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<h2 class="mb-3">@Localizer["PageTitle"]</h2>

<form asp-action="CreateBoard" method="post" class="row g-2 mb-4" style="max-width: 32rem;">
    <div class="col">
        <input type="text" name="name" class="form-control" placeholder="@Localizer["NewBoardPlaceholder"]" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">@Localizer["CreateButton"]</button>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">@Localizer["NoBoards"]</p>
}
else
{
    <div class="row g-3">
        @foreach (var board in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">📋 @board.Name</h5>
                        <div class="d-flex gap-2">
                            <a asp-action="Board" asp-route-id="@board.Id" class="btn btn-sm btn-primary">@Localizer["OpenButton"]</a>
                            <form asp-action="DeleteBoard" method="post" class="mb-0" onsubmit="return confirm('@board.Name');">
                                <input type="hidden" name="id" value="@board.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["DeleteButton"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
