@using HomeOS.Models.LifeAdmin
@model Contact
@inject Microsoft.Extensions.Localization.IStringLocalizer<HomeOS.Controllers.LifeAdminController> L
@{ ViewData["Title"] = L["EditContactTitle"]; }

<h2>@L["EditContactTitle"]</h2>

<form asp-action="EditContact" asp-route-id="@Model.Id" method="post" class="row g-3 mt-2">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_ContactFields" model="Model" />
    <div class="col-12">
        <button type="submit" class="btn btn-primary">@L["SaveButton"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@L["BackButton"]</a>
    </div>
</form>
