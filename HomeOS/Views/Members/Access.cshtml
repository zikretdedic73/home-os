@using HomeOS.Models.Households
@using HomeOS.Models.Modules
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    var member = ViewBag.Member as Member;
    var rows = ViewBag.Rows as List<MemberModuleAccessRow> ?? new List<MemberModuleAccessRow>();
    var who = member == null ? "" : (string.IsNullOrEmpty(member.DisplayName) ? member.Email : member.DisplayName);
    ViewData["Title"] = string.Format(Localizer["PageTitleFormat"].Value, who);
}

<h2 class="mb-2">@string.Format(Localizer["PageTitleFormat"].Value, who)</h2>
<p class="text-muted">@Localizer["Intro"]</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]</div>
}

<ul class="list-group mb-3" style="max-width: 40rem;">
    @foreach (var row in rows)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <span>@row.Icon @row.DisplayName</span>
                @if (row.CanAccess)
                {
                    <span class="badge bg-success ms-2">@Localizer["AllowedBadge"]</span>
                }
                else
                {
                    <span class="badge bg-secondary ms-2">@Localizer["RestrictedBadge"]</span>
                }
            </div>
            <form asp-action="ToggleAccess" method="post" class="mb-0">
                <input type="hidden" name="memberId" value="@member!.Id" />
                <input type="hidden" name="moduleKey" value="@row.Key" />
                <input type="hidden" name="canAccess" value="@((!row.CanAccess).ToString().ToLowerInvariant())" />
                <button type="submit" class="btn btn-sm @(row.CanAccess ? "btn-outline-danger" : "btn-outline-success")">
                    @(row.CanAccess ? Localizer["RestrictButton"] : Localizer["AllowButton"])
                </button>
            </form>
        </li>
    }
</ul>

<a asp-action="Index" class="btn btn-outline-secondary">@Localizer["BackButton"]</a>
