@model IReadOnlyList<HomeOS.Services.ModuleInfo>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<h2 class="mb-2">@Localizer["PageTitle"]</h2>
<p class="text-muted">@Localizer["Intro"]</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]</div>
}

<div class="row g-3">
    @foreach (var module in Model)
    {
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 @(module.IsEnabled ? "" : "opacity-75")">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-4">@module.Descriptor.Icon</div>
                        <h5 class="card-title mb-1">@module.Descriptor.DisplayName</h5>
                        @if (module.IsEnabled)
                        {
                            <span class="badge bg-success">@Localizer["EnabledBadge"]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Localizer["DisabledBadge"]</span>
                        }
                    </div>
                    <form asp-action="Toggle" method="post" class="mb-0">
                        <input type="hidden" name="key" value="@module.Descriptor.Key" />
                        <input type="hidden" name="enabled" value="@((!module.IsEnabled).ToString().ToLowerInvariant())" />
                        <button type="submit" class="btn btn-sm @(module.IsEnabled ? "btn-outline-danger" : "btn-outline-success")">
                            @(module.IsEnabled ? Localizer["DisableButton"] : Localizer["EnableButton"])
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
