@using HomeOS.Models.Notifications
@model IReadOnlyDictionary<NotificationCategory, bool>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<h2 class="mb-2">@Localizer["PageTitle"]</h2>
<p class="text-muted">@Localizer["Intro"]</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]</div>
}

<form asp-action="Index" method="post" class="card">
    <div class="card-body">
        @foreach (var category in Model.Keys)
        {
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch"
                       name="enabledCategories" value="@category"
                       id="cat_@category" checked="@Model[category]" />
                <label class="form-check-label" for="cat_@category">
                    <span class="fw-medium">@Localizer[$"Category_{category}"]</span>
                    <span class="d-block small text-muted">@Localizer[$"CategoryHelp_{category}"]</span>
                </label>
            </div>
        }
    </div>
    <div class="card-footer bg-transparent">
        <button type="submit" class="btn btn-primary">@Localizer["SaveButton"]</button>
    </div>
</form>
