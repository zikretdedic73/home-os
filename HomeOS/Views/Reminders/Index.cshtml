@model List<HomeOS.Models.Reminders.Reminder>
@using HomeOS.Models.Households
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@{
    ViewData["Title"] = Localizer["PageTitle"];
    var members = ViewBag.Members as List<Member>;
    var now = DateTime.UtcNow;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="mb-0">@Localizer["PageTitle"]</h2>
    <a asp-action="Create" class="btn btn-primary">➕ @Localizer["NewReminderButton"]</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <p class="fs-5">@Localizer["NoRemindersMessage"]</p>
        <a asp-action="Create" class="btn btn-outline-primary">@Localizer["AddFirstReminder"]</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var reminder in Model)
        {
            var isDue = reminder.IsDue(now);
            var recipientNames = members?.Where(m => reminder.Recipients.Any(r => r.MemberId == m.Id)).Select(m => m.DisplayName) ?? Enumerable.Empty<string>();

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border-start border-4 @(reminder.IsResolved ? "border-success" : isDue ? "border-danger" : "border-light") @(isDue && !reminder.IsResolved ? "bg-danger-subtle" : "")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title">@reminder.Title</h5>
                            @if (reminder.IsResolved)
                            {
                                <span class="badge bg-success">@Localizer["ResolvedBadge"]</span>
                            }
                            else if (isDue)
                            {
                                <span class="badge bg-danger">@Localizer["DueBadge"]</span>
                            }
                        </div>
                        <p class="small text-muted mb-1">@Localizer["TriggerAtPrefix"] @reminder.TriggerAtUtc.ToString("dd.MM.yyyy HH:mm")</p>
                        @if (!reminder.IsResolved && reminder.SnoozedUntilUtc.HasValue && reminder.SnoozedUntilUtc > now)
                        {
                            <p class="small text-muted mb-1">@string.Format(Localizer["SnoozedUntilFormat"].Value, reminder.SnoozedUntilUtc.Value.ToString("dd.MM.yyyy HH:mm"))</p>
                        }
                        @if (recipientNames.Any())
                        {
                            <p class="small text-muted mb-0">@Localizer["RecipientsPrefix"] @string.Join(", ", recipientNames)</p>
                        }
                    </div>
                    <div class="card-footer bg-transparent d-flex flex-wrap gap-2">
                        <a asp-action="Edit" asp-route-id="@reminder.Id" class="btn btn-sm btn-outline-secondary">@Localizer["EditButton"]</a>
                        <a asp-action="Delete" asp-route-id="@reminder.Id" class="btn btn-sm btn-outline-danger">@Localizer["DeleteButton"]</a>
                        @if (!reminder.IsResolved)
                        {
                            <form asp-action="Resolve" asp-route-id="@reminder.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-success">@Localizer["ResolveButton"]</button>
                            </form>
                            <form asp-action="Snooze" asp-route-id="@reminder.Id" method="post" class="d-inline">
                                <input type="hidden" name="hours" value="1" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@Localizer["SnoozeButton"]</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
