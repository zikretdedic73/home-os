@using Microsoft.Extensions.Localization
@using HomeOS.Resources.Shell
@using HomeOS.Services
@inject IStringLocalizer<SharedLayout> Localizer
@inject ICurrentHouseholdService Household
@inject IReminderNotificationService Reminders
@inject IModuleRegistry ModuleRegistry
@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var searchQuery = Context.Request.Query["q"].ToString();

    var activeReminderCount = 0;
    IReadOnlyList<IModuleDescriptor> navModules = new List<IModuleDescriptor>();
    if (User.Identity?.IsAuthenticated == true)
    {
        var currentHouseholdId = await Household.GetCurrentHouseholdIdAsync();
        var currentMemberId = await Household.GetCurrentMemberIdAsync();
        activeReminderCount = (await Reminders.GetActiveRemindersForMemberAsync(currentHouseholdId, currentMemberId)).Count;

        // Navigation is generated from the module registry, never hardcoded -
        // a new module appears here automatically, a disabled one disappears
        // (Docs/00_Specifikacija_Izvor.md, "automatski vidljiva u navigaciji").
        navModules = await ModuleRegistry.GetEnabledAsync(currentHouseholdId);
    }
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @Localizer["AppName"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">🏠 @Localizer["AppName"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" ? "active fw-semibold" : "")" asp-controller="Home" asp-action="Index">@Localizer["DashboardNavLink"]</a>
                            </li>
                            @foreach (var module in navModules)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController == module.Controller ? "active fw-semibold" : "")" asp-controller="@module.Controller" asp-action="Index">@module.Icon @module.DisplayName</a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Search" asp-action="Index" method="get" class="mb-0" role="search">
                                <input type="search" name="q" value="@searchQuery" class="form-control form-control-sm" style="width: 12rem;" placeholder="@Localizer["SearchPlaceholder"]" aria-label="@Localizer["SearchPlaceholder"]" />
                            </form>
                            <button class="btn btn-primary btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#quickCaptureModal">
                                ➕ @Localizer["QuickCaptureButton"]
                            </button>
                            <a asp-controller="Reminders" asp-action="Index" class="btn btn-outline-secondary btn-sm position-relative" aria-label="@Localizer["RemindersBellLabel"]">
                                🔔
                                @if (activeReminderCount > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">@activeReminderCount</span>
                                }
                            </a>
                            <a asp-controller="Modules" asp-action="Index" class="btn btn-outline-secondary btn-sm" aria-label="@Localizer["ModulesLink"]" title="@Localizer["ModulesLink"]">⚙️</a>
                        }
                        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="mb-0">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <select name="culture" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()" aria-label="@Localizer["LanguageSwitcherLabel"]">
                                <option value="en" selected="@(currentCulture == "en")">EN</option>
                                <option value="bs" selected="@(currentCulture == "bs")">BS</option>
                            </select>
                        </form>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-3 px-md-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="modal fade" id="quickCaptureModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-controller="Home" asp-action="QuickCapture" method="post">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <div class="modal-header">
                            <h5 class="modal-title">@Localizer["QuickCaptureModalTitle"]</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">@Localizer["QuickCaptureTypeLabel"]</label>
                                <select name="type" class="form-select">
                                    <option value="task">@Localizer["QuickCaptureTaskOption"]</option>
                                    <option value="reminder">@Localizer["QuickCaptureReminderOption"]</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@Localizer["QuickCaptureTitleLabel"]</label>
                                <input type="text" name="title" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">@Localizer["QuickCaptureWhenLabel"]</label>
                                <input type="datetime-local" name="when" class="form-control" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["QuickCaptureCancelButton"]</button>
                            <button type="submit" class="btn btn-primary">@Localizer["QuickCaptureSaveButton"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* Command palette (Ctrl+K) - jump to any enabled module or run a search.
           Targets are generated from the same module registry as the navbar. *@
        <div class="modal fade" id="commandPalette" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@Localizer["CommandPaletteTitle"]</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="text" id="commandPaletteInput" class="form-control mb-2" placeholder="@Localizer["CommandPalettePlaceholder"]" autocomplete="off" />
                        <ul id="commandPaletteResults" class="list-group"></ul>
                        <div class="form-text mt-2">@Localizer["CommandPaletteHint"]</div>
                    </div>
                </div>
            </div>
        </div>

        <script type="application/json" id="commandPaletteData">
            @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                new[] { new { name = Localizer["DashboardNavLink"].Value, url = Url.Action("Index", "Home"), icon = "🏠" } }
                    .Concat(navModules.Select(m => new { name = m.DisplayName, url = Url.Action("Index", m.Controller), icon = m.Icon }))))
        </script>
        <script>
            window.homeOsCommandPalette = {
                searchPrefix: '@Localizer["CommandPaletteSearchPrefix"]',
                searchUrl: '@Url.Action("Index", "Search")'
            };
        </script>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
