@model HomeOS.Models.Tasks.TaskItem
@using HomeOS.Models.Households
@using HomeOS.Models.Tasks
@using HomeOS.Models.Common
@using Microsoft.AspNetCore.Mvc.Rendering
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<TaskEnums> EnumLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<VisibilityLabels> VisLoc
@{
    ViewData["Title"] = Localizer["PageTitle"];
    var members = ViewBag.Members as List<Member>;
    var priorityOptions = Enum.GetValues<TaskPriority>()
        .Select(p => new SelectListItem(EnumLocalizer[$"TaskPriority_{p}"], p.ToString()));
    var statusOptions = Enum.GetValues<TaskState>()
        .Select(s => new SelectListItem(EnumLocalizer[$"TaskState_{s}"], s.ToString()));
    var visibilityOptions = new List<SelectListItem>
    {
        new(VisLoc["Household"].Value, "Household"),
        new(VisLoc["Private"].Value, "Private"),
        new(VisLoc["SpecificMembers"].Value, "SpecificMembers")
    };
}

<h2>@Localizer["PageTitle"]</h2>

<form asp-action="Create" method="post" class="row g-3 mt-2">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-12">
        <label class="form-label">@Localizer["TitleLabel"]</label>
        <input asp-for="Title" class="form-control" required />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label class="form-label">@Localizer["DescriptionLabel"]</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-12 col-md-4">
        <label class="form-label">@Localizer["DueDateLabel"]</label>
        <input asp-for="DueDate" type="date" class="form-control" />
    </div>
    <div class="col-12 col-md-4">
        <label class="form-label">@Localizer["PriorityLabel"]</label>
        <select asp-for="Priority" class="form-select" asp-items="priorityOptions"></select>
    </div>
    <div class="col-12 col-md-4">
        <label class="form-label">@Localizer["StatusLabel"]</label>
        <select asp-for="Status" class="form-select" asp-items="statusOptions"></select>
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">@Localizer["AssigneeLabel"]</label>
        <select asp-for="AssigneeId" class="form-select">
            <option value="">@Localizer["UnassignedOption"]</option>
            @if (members != null)
            {
                foreach (var m in members)
                {
                    <option value="@m.Id">@m.DisplayName</option>
                }
            }
        </select>
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">@Localizer["TagsLabel"]</label>
        <input name="tagsInput" class="form-control" placeholder="@Localizer["TagsPlaceholder"]" />
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">@VisLoc["Label"]</label>
        <select asp-for="Visibility" class="form-select" asp-items="visibilityOptions" id="visibilitySelect"></select>
    </div>
    <div class="col-12" id="shareMembersBlock" style="display:none;">
        <label class="form-label">@VisLoc["SpecificMembersHelp"]</label>
        <div class="d-flex flex-wrap gap-3 border rounded p-2">
            @if (members != null)
            {
                foreach (var m in members)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="shareMemberIds"
                               value="@m.Id" id="share_@m.Id" />
                        <label class="form-check-label" for="share_@m.Id">@m.DisplayName</label>
                    </div>
                }
            }
        </div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">@Localizer["SaveButton"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["CancelButton"]</a>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            var sel = document.getElementById('visibilitySelect');
            var block = document.getElementById('shareMembersBlock');
            if (!sel || !block) return;
            function sync() { block.style.display = sel.value === 'SpecificMembers' ? '' : 'none'; }
            sel.addEventListener('change', sync);
            sync();
        })();
    </script>
}
